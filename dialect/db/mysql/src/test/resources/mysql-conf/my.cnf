# A minimal server configuration for the Docker tests: Testcontainers' default sets innodb_log_file_size,
# which MySQL 9 no longer knows and refuses to start with.
#
# log_bin_trust_function_creators: from 8.0 binary logging is on, and a user without SUPER, as the tests' user is,
# may create a trigger or a function only with it.
[mysqld]
skip-name-resolve
log_bin_trust_function_creators = 1
